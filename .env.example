# App
APP_ENV=development
LOG_LEVEL=INFO

# Paths (inside container: /app/...)
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
MODELS_DIR=./models

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=oran_specs
QDRANT_DISTANCE=Cosine
QDRANT_UPSERT_BATCH_SIZE=128

# OpenAI (embeddings + LLM)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_EMBEDDING_BATCH_SIZE=128
OPENAI_CHAT_MODEL=gpt-4o-mini

# Retrieval
CHUNK_SIZE_TOKENS=512
RETRIEVAL_TOP_K=8
PARSED_CORPUS_DIR=./data/corpus/parsed

# Local LLM (host GPU Week 8)
LOCAL_LLM_BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct
LORA_ADAPTER_PATH=./models/lora-rca-v1
