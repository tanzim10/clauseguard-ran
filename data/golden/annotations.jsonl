{"id": "spec_qa_001", "status": "approved", "reviewer": "tanzim10", "reviewed_on": "2026-10-14", "families": ["direct"], "tags": ["kpi", "throughput"], "evidence": [{"claim": "The measurement name is DRB.UEThpDl, or optionally DRB.UEThpDl.QOS.", "alternatives": [{"spec_id": "3GPP TS 28.552", "version": "18.7.0", "sha256": "9785644b0c5a3060ced870ba3470ea3f02212262d518b2b919b1c40ec0e9b5b6", "clause": "5.1.1.3.1", "title": "Average DL UE throughput in gNB", "pdf_page": 50}]}, {"claim": "ThpVolDl excludes the volume of the last piece of data emptying the buffer.", "alternatives": [{"spec_id": "3GPP TS 28.552", "version": "18.7.0", "sha256": "9785644b0c5a3060ced870ba3470ea3f02212262d518b2b919b1c40ec0e9b5b6", "clause": "5.1.1.3.1", "title": "Average DL UE throughput in gNB", "pdf_page": 49}]}]}
{"id": "spec_qa_002", "status": "approved", "reviewer": "tanzim10", "reviewed_on": "2026-10-14", "families": ["direct"], "tags": ["kpi", "prb"], "evidence": [{"claim": "RRU.PrbUsedDl is the average number of PRBs used in DL for data traffic.", "alternatives": [{"spec_id": "3GPP TS 28.552", "version": "18.7.0", "sha256": "9785644b0c5a3060ced870ba3470ea3f02212262d518b2b919b1c40ec0e9b5b6", "clause": "5.1.1.2.5", "title": "Mean DL PRB used for data traffic", "pdf_page": 40}]}, {"claim": "The measurement is collected on NRCellDU.", "alternatives": [{"spec_id": "3GPP TS 28.552", "version": "18.7.0", "sha256": "9785644b0c5a3060ced870ba3470ea3f02212262d518b2b919b1c40ec0e9b5b6", "clause": "5.1.1.2.5", "title": "Mean DL PRB used for data traffic", "pdf_page": 40}]}]}
{"id": "spec_qa_003", "status": "approved", "reviewer": "tanzim10", "reviewed_on": "2026-10-14", "families": ["multi_clause"], "tags": ["kpi", "throughput", "comparison"], "evidence": [{"claim": "The average measurement is computed from ThpVolDl and ThpTimeDl, with separate counters per mapped 5QI, S-NSSAI, PLMN ID and Active BWP.", "alternatives": [{"spec_id": "3GPP TS 28.552", "version": "18.7.0", "sha256": "9785644b0c5a3060ced870ba3470ea3f02212262d518b2b919b1c40ec0e9b5b6", "clause": "5.1.1.3.1", "title": "Average DL UE throughput in gNB", "pdf_page": 49}]}, {"claim": "The distribution measurement splits measurement time T into n samples of equal period and computes throughput per sample.", "alternatives": [{"spec_id": "3GPP TS 28.552", "version": "18.7.0", "sha256": "9785644b0c5a3060ced870ba3470ea3f02212262d518b2b919b1c40ec0e9b5b6", "clause": "5.1.1.3.2", "title": "Distribution of DL UE throughput in gNB", "pdf_page": 50}]}]}
